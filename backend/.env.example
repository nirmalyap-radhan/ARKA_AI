# Google Gemini API Key (Get a free API key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Centralized Gemini Model Configuration
# Recommended model: gemini-3.8-flash (official Google Gen AI free-tier model)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Vision model override (defaults to GEMINI_MODEL)
GEMINI_VISION_MODEL=gemini-3.8-flash

# Allowed CORS Origins (comma-separated list for Render & local dev)
CORS_ORIGINS=https://arka-ai-woad.vercel.app,http://localhost:5173,http://localhost:3000

# Server Port (automatically set by Render in production)
PORT=8000
